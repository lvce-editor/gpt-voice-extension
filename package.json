{
  "name": "builtin.gpt-voice-monorepo",
  "version": "0.0.0-dev",
  "description": "gpt-voice extension monorepo for Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:extension": "node packages/build/src/build-extension.ts",
    "build:static": "node scripts/build-static.ts",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "fixture:generate": "node packages/fixture-generator/src/generateFixture.ts",
    "format": "prettier --write .",
    "install:extension": "node packages/build/src/install-extension.ts",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "type-check": "tsc -b"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.4.0",
    "eslint": "^10.8.1",
    "knip": "^6.32.1",
    "prettier": "^4.0.0-alpha.10",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
