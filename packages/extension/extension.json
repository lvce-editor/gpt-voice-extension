{
  "id": "builtin.gpt-voice",
  "name": "gpt-voice",
  "workerName": "gpt-voice Worker",
  "description": "Gpt Voice extension for Lvce Editor",
  "repository": "https://github.com/levivilet/gpt-voice-extension",
  "browser": "dist/gptVoiceMain.js",
  "isolated": true,
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "connect-src 'self' https://api.openai.com"
  ],
  "categories": ["Other"],
  "configuration": {
    "gptvoice.tools.terminal.enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow Gpt Voice to execute Bash commands in the opened workspace. Enabling this gives the voice model arbitrary code execution access."
    }
  },
  "activation": [
    "onCommand:gpt-voice.show",
    "onView:gpt-voice.views.default",
    "onCommand:GptVoice.handleClickStart",
    "onCommand:GptVoice.captureFixture",
    "onCommand:GptVoice.handleData",
    "onCommand:GptVoice.handleClearOpenAiApiKey",
    "onCommand:GptVoice.handleOpenAiApiKeyInput",
    "onCommand:GptVoice.handleSaveOpenAiApiKey",
    "onCommand:GptVoice.replayFixture",
    "onCommand:GptVoice.setIsTest",
    "onCommand:GptVoice.setAnimation",
    "onCommand:GptVoice.setRealtimeModelMini",
    "onCommand:GptVoice.setRealtimeModelStandard",
    "onCommand:GptVoice.addTranscript",
    "onCommand:GptVoice.stop"
  ],
  "commands": [
    {
      "id": "gpt-voice.show",
      "label": "gpt-voice: Show"
    },
    {
      "id": "GptVoice.handleClickStart",
      "label": "gpt-voice: Handle Click Start"
    },
    {
      "id": "GptVoice.captureFixture",
      "label": "gpt-voice: Capture fixture"
    },
    {
      "id": "GptVoice.handleData",
      "label": "gpt-voice: Handle Data"
    },
    {
      "id": "GptVoice.handleClearOpenAiApiKey",
      "label": "gpt-voice: Clear OpenAI API key"
    },
    {
      "id": "GptVoice.handleOpenAiApiKeyInput",
      "label": "gpt-voice: Handle OpenAI API key input"
    },
    {
      "id": "GptVoice.handleSaveOpenAiApiKey",
      "label": "gpt-voice: Save OpenAI API key"
    },
    {
      "id": "GptVoice.replayFixture",
      "label": "gpt-voice: Replay fixture"
    },
    {
      "id": "GptVoice.setIsTest",
      "label": "gpt-voice: setIsTest"
    },
    {
      "id": "GptVoice.setAnimation",
      "label": "gpt-voice: setAnimation"
    },
    {
      "id": "GptVoice.setRealtimeModelMini",
      "label": "gpt-voice: setRealtimeModelMini"
    },
    {
      "id": "GptVoice.setRealtimeModelStandard",
      "label": "gpt-voice: setRealtimeModelStandard"
    },
    {
      "id": "GptVoice.addTranscript",
      "label": "gpt-voice: add Transcript"
    },
    {
      "id": "GptVoice.stop",
      "label": "gpt-voice: stop"
    }
  ],
  "keybindings": [],
  "views": [
    {
      "css": "media/gpt-voice.css",
      "displayName": "Gpt Voice",
      "id": "gpt-voice.views.default",
      "title": "Gpt Voice",
      "icon": "media/voice-chat.svg",
      "kind": "virtualDom"
    }
  ],
  "rpc": [
    {
      "id": "builtin.gpt-voice.terminal-node",
      "type": "node",
      "name": "Gpt Voice Terminal",
      "url": "dist/terminalNodeMain.js"
    },
    {
      "id": "builtin.gpt-voice.voice-function-calling-worker",
      "type": "web-worker",
      "name": "Voice Function Calling Worker",
      "url": "dist/voiceFunctionCallingWorkerMain.js",
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"]
    }
  ]
}
